// SPDX-License-Identifier: BSD-3-Clause
/* VR700 stock runtime FDT: four OV7251 sensors, probed as ID 0x7750.
 * Slot 0/1: CCI0 bus 0/1, PHY5/4; slot 2/3: CCI1 bus 0/1, PHY2/3.
 * Sensor endpoints number the source lanes; Qualcomm PHY numbers data from
 * zero and the dedicated clock lane as seven.
 */
#include <dt-bindings/media/video-interfaces.h>

/ {
	cam_pair01_avdd: regulator-cam-pair01-avdd {
		compatible = "regulator-fixed";
		regulator-name = "cam-pair01-avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&vreg_l6f>;
		gpio = <&tlmm 43 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};

	cam_pair01_iovdd: regulator-cam-pair01-iovdd {
		compatible = "regulator-fixed";
		regulator-name = "cam-pair01-iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vreg_l7f>;
		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};

	cam_pair23_avdd: regulator-cam-pair23-avdd {
		compatible = "regulator-fixed";
		regulator-name = "cam-pair23-avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&vreg_l6f>;
		gpio = <&tlmm 117 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};

	cam_pair23_iovdd: regulator-cam-pair23-iovdd {
		compatible = "regulator-fixed";
		regulator-name = "cam-pair23-iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vreg_l7f>;
		gpio = <&tlmm 116 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};
};

&camss {
	vdda-phy-supply = <&vreg_l5a>;
	vdda-pll-supply = <&vreg_l9a>;
	pinctrl-names = "default";
	pinctrl-0 = <&controller_phase_default>;
	/* Stock cell-index 0 exports CAM_C1/CAM_C2 on GPIO92/GPIO93. */
	qcom,controller-phase-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>,
				      <&tlmm 93 GPIO_ACTIVE_HIGH>;
	qcom,controller-phase-csid = <2>;
	status = "okay";

	ports {
		port@5 {
			csiphy5_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				remote-endpoint = <&ov7251_0_ep>;
			};
		};
		port@4 {
			csiphy4_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				remote-endpoint = <&ov7251_1_ep>;
			};
		};
		port@2 {
			csiphy2_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				remote-endpoint = <&ov7251_2_ep>;
			};
		};
		port@3 {
			csiphy3_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				remote-endpoint = <&ov7251_3_ep>;
			};
		};
	};
};

&cci0 { status = "okay"; };
&cci1 { status = "okay"; };

&cci0_i2c0 {
	ov7251_0: camera@60 {
		compatible = "ovti,ov7251";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK5_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&camcc CAM_CC_MCLK5_CLK>;
		assigned-clock-rates = <24000000>;
		vdda-supply = <&cam_pair01_avdd>;
		vdddo-supply = <&cam_pair01_iovdd>;
		enable-gpios = <&tlmm 130 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam0_vr700_default>;

		port {
			ov7251_0_ep: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <240000000>;
				remote-endpoint = <&csiphy5_ep>;
			};
		};
	};
};

&cci0_i2c1 {
	ov7251_1: camera@60 {
		compatible = "ovti,ov7251";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK4_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
		assigned-clock-rates = <24000000>;
		vdda-supply = <&cam_pair01_avdd>;
		vdddo-supply = <&cam_pair01_iovdd>;
		enable-gpios = <&tlmm 131 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam1_vr700_default>;

		port {
			ov7251_1_ep: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <240000000>;
				remote-endpoint = <&csiphy4_ep>;
			};
		};
	};
};

&cci1_i2c0 {
	ov7251_2: camera@60 {
		compatible = "ovti,ov7251";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
		assigned-clock-rates = <24000000>;
		vdda-supply = <&cam_pair23_avdd>;
		vdddo-supply = <&cam_pair23_iovdd>;
		enable-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam2_vr700_default>;

		port {
			ov7251_2_ep: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <240000000>;
				remote-endpoint = <&csiphy2_ep>;
			};
		};
	};
};

&cci1_i2c1 {
	ov7251_3: camera@60 {
		compatible = "ovti,ov7251";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK3_CLK>;
		clock-names = "xclk";
		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
		assigned-clock-rates = <24000000>;
		vdda-supply = <&cam_pair23_avdd>;
		vdddo-supply = <&cam_pair23_iovdd>;
		enable-gpios = <&tlmm 109 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam3_vr700_default>;

		port {
			ov7251_3_ep: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <240000000>;
				remote-endpoint = <&csiphy3_ep>;
			};
		};
	};
};

&tlmm {
	controller_phase_default: controller-phase-default-state {
		pins = "gpio92", "gpio93";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	cam0_vr700_default: cam0-vr700-default-state {
		mclk-pins {
			pins = "gpio99";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};
		reset-pins {
			pins = "gpio130";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};
	cam1_vr700_default: cam1-vr700-default-state {
		mclk-pins {
			pins = "gpio98";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};
		reset-pins {
			pins = "gpio131";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};
	cam2_vr700_default: cam2-vr700-default-state {
		mclk-pins {
			pins = "gpio96";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};
		reset-pins {
			pins = "gpio78";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};
	cam3_vr700_default: cam3-vr700-default-state {
		mclk-pins {
			pins = "gpio97";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};
		reset-pins {
			pins = "gpio109";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};
};
