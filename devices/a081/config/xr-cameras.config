# SPDX-License-Identifier: GPL-2.0-only
# Accepted six-camera kernel configuration relative to the common A081 base.
# Keep the early image within the existing 16 MiB boot window.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_LOG_BUF_SHIFT=14
CONFIG_PERF_EVENTS=y
CONFIG_STACKTRACE=y
CONFIG_ARM64_BRBE=y
# CONFIG_ARM_CCI_PMU is not set
# CONFIG_ARM_CCN is not set
# CONFIG_ARM_CMN is not set
# CONFIG_ARM_CORESIGHT_PMU_ARCH_SYSTEM_PMU is not set
# CONFIG_ARM_DSU_PMU is not set
# CONFIG_ARM_NI is not set
CONFIG_ARM_PMU=y
CONFIG_ARM_PMUV3=y
# CONFIG_ARM_SMMU_V3_PMU is not set
# CONFIG_ARM_SPE_PMU is not set
# CONFIG_ATH11K_TRACING is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_BOOTTIME_TRACING is not set
CONFIG_BPF_EVENTS=y
# CONFIG_BPF_LSM is not set
CONFIG_BRANCH_PROFILE_NONE=y
CONFIG_BUILDTIME_MCOUNT_SORT=y
# CONFIG_CGROUP_PERF is not set
CONFIG_CONTEXT_SWITCH_TRACER=y
# CONFIG_DEBUG_CGROUP_REF is not set
# CONFIG_DEBUG_PAGE_REF is not set
# CONFIG_DEBUG_PERF_USE_VMALLOC is not set
# CONFIG_DWC_PCIE_PMU is not set
CONFIG_DYNAMIC_EVENTS=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_ARGS=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y
CONFIG_EPROBE_EVENTS=y
CONFIG_EVENT_TRACING=y
# CONFIG_FPROBE is not set
CONFIG_FTRACE_MCOUNT_USE_PATCHABLE_FUNCTION_ENTRY=y
# CONFIG_FTRACE_RECORD_RECURSION is not set
# CONFIG_FTRACE_SORT_STARTUP_TEST is not set
# CONFIG_FTRACE_STARTUP_TEST is not set
CONFIG_FTRACE_SYSCALLS=y
# CONFIG_FTRACE_VALIDATE_RCU_IS_WATCHING is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_FUNCTION_PROFILER is not set
# CONFIG_FUNCTION_SELF_TRACING is not set
CONFIG_FUNCTION_TRACER=y
CONFIG_GENERIC_TRACER=y
CONFIG_HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y
CONFIG_HAVE_HW_BREAKPOINT=y
# CONFIG_HID_BPF is not set
# CONFIG_HISI_PCIE_PMU is not set
# CONFIG_HISI_PTT is not set
# CONFIG_HIST_TRIGGERS is not set
# CONFIG_HNS3_PMU is not set
# CONFIG_HWLAT_TRACER is not set
CONFIG_HW_PERF_EVENTS=y
# CONFIG_IRQSOFF_TRACER is not set
CONFIG_KPROBE_EVENTS=y
# CONFIG_KPROBE_EVENTS_ON_NOTRACE is not set
# CONFIG_KPROBE_EVENT_GEN_TEST is not set
CONFIG_KRETPROBES=y
# CONFIG_MAC80211_MESSAGE_TRACING is not set
CONFIG_MODULES_TREE_LOOKUP=y
# CONFIG_NET_DROP_MONITOR is not set
CONFIG_NOP_TRACER=y
# CONFIG_OSNOISE_TRACER is not set
# CONFIG_PREEMPTIRQ_DELAY_TEST is not set
# CONFIG_PREEMPT_TRACER is not set
CONFIG_PROBE_EVENTS=y
# CONFIG_PROBE_EVENTS_DUMP_FETCHARG is not set
# CONFIG_PROFILE_ALL_BRANCHES is not set
# CONFIG_PROFILE_ANNOTATED_BRANCHES is not set
# CONFIG_PSTORE_FTRACE is not set
# CONFIG_QCOM_PMIC_PDCHARGER_ULOG is not set
# CONFIG_QUEUED_SPINLOCKS_TRACE_CONTENDED_RELEASE is not set
CONFIG_RING_BUFFER=y
# CONFIG_RING_BUFFER_BENCHMARK is not set
# CONFIG_RING_BUFFER_PERSISTENT_INJECT is not set
# CONFIG_RING_BUFFER_STARTUP_TEST is not set
# CONFIG_RING_BUFFER_VALIDATE_TIME_DELTAS is not set
# CONFIG_RV is not set
# CONFIG_SCHED_TRACER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_SYNTH_EVENTS is not set
CONFIG_TASKS_RUDE_RCU=y
# CONFIG_TIMERLAT_TRACER is not set
CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED=y
CONFIG_TRACEPOINTS=y
# CONFIG_TRACEPOINT_BENCHMARK is not set
# CONFIG_TRACER_SNAPSHOT is not set
CONFIG_TRACE_CLOCK=y
# CONFIG_TRACE_EVAL_MAP_FILE is not set
# CONFIG_TRACE_EVENT_INJECT is not set
# CONFIG_TRACE_MMIO_ACCESS is not set
# CONFIG_TRACE_REMOTE_TEST is not set
CONFIG_TRACE_SYSCALL_BUF_SIZE_DEFAULT=63
CONFIG_TRACING=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
# CONFIG_USER_EVENTS is not set
