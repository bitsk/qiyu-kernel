# SPDX-License-Identifier: GPL-2.0-only
# Optional A081 XR scheduling candidate; no device acceptance is implied.
CONFIG_LOCALVERSION="-qiyu-mix-scheduling"
CONFIG_CPUSETS=y
# CONFIG_CPUSETS_V1 is not set
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_ENERGY_MODEL=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
# Preserve PREEMPT, schedutil and HZ=250 from the base configuration.
# Keep existing application FIFO/RR admission without new RT group budgets.
# CONFIG_RT_GROUP_SCHED is not set
# Retain the deployed kernel's small printk ring and use event tracing rather
# than instrumenting every function within the fixed ABL kernel memory window.
CONFIG_LOG_BUF_SHIFT=14
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_SCHED_TRACER=y
# CONFIG_FUNCTION_TRACER is not set
