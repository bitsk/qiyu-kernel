@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* A081 stock profile, revision 24. Generated by prepare_fg4_profile.py.
+ * These configure the gauge; they do not set charger current limits.
+ */
+qcom,battery-id-ohms = <100000>;
+qcom,battery-id-tolerance-percent = <15>;
+qcom,fg-full-voltage-microvolt = <4390000>;
+qcom,therm-coefficients = <8984 3340 56055 50518 33933>;
+qcom,therm-center-offset = <112>;
+qcom,therm-pull-up-ohms = <100000>;
+qcom,fg-profile-data = [
+	09 00 a2 ea 44 e5 91 ea 29 e5 00 00 dd bc 56 8b
+	f6 87 a0 80 94 9d 43 80 16 00 98 05 36 0b 91 05
