+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Qiyu MIX (A081), initial Linux bring-up.
+ * Wiring/voltages: Backup-r1-135750 boot + MIX DTBO.
+ * See reports/PORTING.md for evidence and unverified hardware assumptions.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/thermal/thermal.h>
+#include "sm8250.dtsi"
+#include "pm8150.dtsi"
+#include "pm8150b.dtsi"
+#include "pm8150l.dtsi"
+
+/ {
+	model = "iQIYI Qiyu MIX (A081)";
+	compatible = "iqiyi,a081", "qcom,sm8250";
+
+	/* Live A081: soc_id 356, revision 2.1, ro.boot.dtb_idx=0. */
+	qcom,msm-id = <356 0x20001>;
+	qcom,board-id = <0x01010008 0>;
+
+	aliases {
+		serial0 = &uart12;
+		serial1 = &uart6;
+	};
+
+	/* WCN6851 is the hw1.1 QCA6490 assembly (SoC 0x400c0110).
+	 * All PMU inputs vote the same five physical rails used by stock CNSS/BT.
+	 * Rail voltages are the r1 stock regulator_summary readings with
+	 * WLAN associated; downstream nominal values need not be valid selectors.
+	 * The internal PMU pin grouping follows the WCN6851 HDK description;
+	 * A081 has not independently verified the PMU/MX/CX package pin routes.
+	 */
+	wcn6851-pmu {
+		compatible = "qcom,wcn6851-pmu", "qcom,wcn6855-pmu";
+		pinctrl-names = "default";
+		pinctrl-0 = <&radio_enable_default &bt_swctrl_default>;
+		wlan-enable-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+		swctrl-gpios = <&tlmm 124 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&vreg_s4a>;
+		vddaon-supply = <&vreg_s6a>;
+		vddpmu-supply = <&vreg_s6a>;
+		vddpmumx-supply = <&vreg_s2f>;
+		vddpmucx-supply = <&vreg_s6a>;
+		vddrfa0p95-supply = <&vreg_s6a>;
+		vddrfa1p3-supply = <&vreg_s8c>;
+		vddrfa1p9-supply = <&vreg_s5a>;
+		vddpcie1p3-supply = <&vreg_s8c>;
+		vddpcie1p9-supply = <&vreg_s5a>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 { regulator-name = "pmu-rfa-cmn"; };
+			vreg_pmu_aon: ldo1 { regulator-name = "pmu-aon"; };
+			vreg_pmu_wlcx: ldo2 { regulator-name = "pmu-wlcx"; };
+			vreg_pmu_wlmx: ldo3 { regulator-name = "pmu-wlmx"; };
+			vreg_pmu_btcmx: ldo4 { regulator-name = "pmu-btcmx"; };
+			vreg_pmu_pcie1p8: ldo5 { regulator-name = "pmu-pcie1p8"; };
+			vreg_pmu_pcie0p9: ldo6 { regulator-name = "pmu-pcie0p9"; };
+			vreg_pmu_rfa0p8: ldo7 { regulator-name = "pmu-rfa0p8"; };
+			vreg_pmu_rfa1p2: ldo8 { regulator-name = "pmu-rfa1p2"; };
+			vreg_pmu_rfa1p7: ldo9 { regulator-name = "pmu-rfa1p7"; };
+		};
+	};
+
+	/* Numeric values from the selected A081 stock battery profile. */
+	a081_battery: battery {
+		compatible = "simple-battery";
+		voltage-max-design-microvolt = <4400000>;
+		charge-full-design-microamp-hours = <5500000>;
+		/* Effective stock BATT_PROFILE votes, read on this A081. */
+		constant-charge-voltage-max-microvolt = <4400000>;
+		constant-charge-current-max-microamp = <5500000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/* Keep bootloader resources alive during the first diagnostic boot. */
+		bootargs = "console=ttyMSM0,115200n8 earlycon=qcom_geni,0xa90000 keep_bootcon loglevel=8 ignore_loglevel clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=0";
+	};
+
+	fan {
+		compatible = "pwm-fan";
+		pwms = <&pm8150l_lpg 4 40000>;
+		fan-supply = <&fan_power>;
+		cooling-levels = <0 255>;
+		#cooling-cells = <2>;
+	};
+
+	/* Stock fan driver owns global GPIO1214 = TLMM base1100 + GPIO114.
+	 * Voltage and upstream source are not yet known. Do not invent them.
+	 */
+	fan_power: regulator-fan-power {
+		compatible = "regulator-fixed";
+		regulator-name = "fan-power";
+		gpio = <&tlmm 114 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_back_default &key_confirm_volume_default>;
+
+		key-confirm {
+			label = "confirm";
+			gpios = <&pm8150_gpios 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_ENTER>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+
+		key-back {
+			label = "back";
+			gpios = <&pm8150_gpios 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_BACK>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+
+		key-volume-up {
+			label = "vol_up";
+			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	reserved-memory {
+		/* Stock splash and display dump describe the same physical region. */
+		framebuffer_reserved: memory@9c000000 {
+			reg = <0x0 0x9c000000 0x0 0x2700000>;
+			no-map;
+		};
+
+		/* Stock node's unit address is stale; use its actual reg value. */
+		dfps_reserved: memory@9e700000 {
+			reg = <0x0 0x9e700000 0x0 0x100000>;
+			no-map;
+		};
+	};
+
+	thermal-zones {
+		/* These are the stock skin NTC channels. The stock userspace
+		 * zones have placeholder 125 C trips and no active skin policy.
+		 * 45/43 C is a provisional board policy, not OEM calibration.
+		 */
+		skin-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <1000>;
+			thermal-sensors = <&pm8150_adc_tm 0>;
+
+			trips {
+				skin_alert: trip-passive {
+					temperature = <45000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&skin_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		skin-msm-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <1000>;
+			thermal-sensors = <&pm8150l_adc_tm 0>;
+
+			trips {
+				skin_msm_alert: trip-passive {
+					temperature = <45000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&skin_msm_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+};
+
+/* Stock A081 cpu-1-*-step: throttle at 75 C, release below 70 C.
+ * Keep the existing higher TSENS trips and the earlier 85 C GPU trip.
+ */
+&cpu4_top_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu5_top_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu6_top_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu7_top_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu4_bottom_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu5_bottom_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu6_bottom_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&cpu7_bottom_alert0 {
+	temperature = <75000>;
+	hysteresis = <5000>;
+};
+
+&pm8150_adc {
+	channel@4d {
+		reg = <ADC5_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "skin_therm";
+	};
+};
+
+&pm8150_adc_tm {
+	status = "okay";
+
+	skin-therm@0 {
+		reg = <0>;
+		io-channels = <&pm8150_adc ADC5_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time-us = <200>;
+	};
+};
+
+&pm8150l_adc {
+	/* Stock "test_ipd" voltage input; mechanical mapping is not calibrated. */
+	channel@12 {
+		reg = <ADC5_GPIO1>;
+		qcom,pre-scaling = <1 1>;
+		label = "test_ipd";
+	};
+
+	channel@4e {
+		reg = <ADC5_AMUX_THM2_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		label = "skin_msm_therm";
+	};
+};
+
+&pm8150l_adc_tm {
+	status = "okay";
+
+	skin-msm-therm@0 {
+		reg = <0>;
+		io-channels = <&pm8150l_adc ADC5_AMUX_THM2_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time-us = <200>;
+	};
+};
+
+/* The stock PAS IDs, SMP2P/GLINK endpoints and all three carveouts match
+ * sm8250.dtsi. Keep the OEM-signed split images together under this path.
+ */
+&adsp {
+	firmware-name = "qcom/sm8250/iqiyi/a081/adsp.mdt";
+	status = "okay";
+};
+
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8150-rpmh-regulators";
+		qcom,pmic-id = "a";
+		qcom,always-wait-for-ack;
+
+		/* Parent rails remain firmware-managed until board routing is known. */
+		vreg_s4a: smps4 {
+			regulator-name = "vreg_s4a";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2a: ldo2 {
+			regulator-name = "vreg_l2a";
+			regulator-min-microvolt = <3072000>;
+			regulator-max-microvolt = <3072000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
