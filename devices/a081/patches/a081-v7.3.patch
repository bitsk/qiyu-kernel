+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_A081_NORDIC_H
+#define _UAPI_LINUX_A081_NORDIC_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define A081_NORDIC_FRAME_SIZE 36
+
+/* Fixed layout for both 32-bit and 64-bit clients. Only tx is input. */
+struct a081_nordic_transfer {
+	__u8 tx[A081_NORDIC_FRAME_SIZE];
+	__u8 rx[A081_NORDIC_FRAME_SIZE];
+	__aligned_u64 irq_timestamp_ns;
+	__aligned_u64 completion_timestamp_ns;
+	__aligned_u64 irq_sequence;
+};
+
+#define A081_NORDIC_IOC_TRANSFER _IOWR('N', 0xa0, struct a081_nordic_transfer)
+
+#endif
