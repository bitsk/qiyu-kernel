+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/qcom,pm8150b-fg.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PM8150B fuel gauge
+
+maintainers:
+  - Qiyu Project <qiyu@example.invalid>
+
+description: |
+  The GEN4 fuel gauge contains SOC, battery information, round-robin ADC,
+  memory arbitration and six DMA windows. The register address identifies
+  the SOC peripheral; the other blocks have fixed offsets from it.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: qcom,pm8150b-fg
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 5
+
+  interrupt-names:
+    items:
+      - const: soc-ready
+      - const: msoc-delta
+      - const: batt-missing
+      - const: batt-temp-delta
+      - const: vbatt-low
+
+  monitored-battery: true
+
+  qcom,fg-profile-data:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 416
+    maxItems: 416
+    description: |
+      Battery characterization data for SRAM words 65 through 272. Algorithm
+      nominal capacity in this data can differ from the battery design rating.
+
+  qcom,battery-id-ohms:
+    description: Battery identification resistor for this characterization profile.
+    minimum: 1
+
+  qcom,battery-id-tolerance-percent:
+    minimum: 0
+    maximum: 100
+    description: Maximum difference from the identification resistor in percent.
+
+  qcom,fg-full-voltage-microvolt:
+    minimum: 2000000
+    maximum: 5500000
+    description: Gauge full-voltage threshold, no greater than battery design maximum.
+
+  qcom,therm-coefficients:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 5
+    maxItems: 5
+    items:
+      maximum: 65535
+    description: Five 16-bit coefficients for the battery thermistor polynomial.
+
+  qcom,therm-center-offset:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 255
+    description: Battery thermistor ratio center offset.
+
+  qcom,therm-pull-up-ohms:
+    enum: [30000, 100000, 400000]
+    description: Internal pull-up resistance for the battery thermistor.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - monitored-battery
+  - qcom,fg-profile-data
+  - qcom,battery-id-ohms
+  - qcom,battery-id-tolerance-percent
+  - qcom,fg-full-voltage-microvolt
+  - qcom,therm-coefficients
+  - qcom,therm-center-offset
+  - qcom,therm-pull-up-ohms
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      fuel-gauge@4000 {
+        compatible = "qcom,pm8150b-fg";
+        reg = <0x4000>;
+        interrupts = <2 0x40 1 IRQ_TYPE_EDGE_BOTH>,
