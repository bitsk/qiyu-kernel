+                     <2 0x42 0 IRQ_TYPE_EDGE_BOTH>,
+                     <2 0x42 2 IRQ_TYPE_EDGE_BOTH>,
+                     <2 0x41 0 IRQ_TYPE_EDGE_BOTH>;
+        interrupt-names = "soc-ready", "msoc-delta", "batt-missing",
+                          "batt-temp-delta", "vbatt-low";
+        monitored-battery = <&battery>;
+
+        qcom,battery-id-ohms = <100000>;
+        qcom,battery-id-tolerance-percent = <15>;
+        qcom,fg-full-voltage-microvolt = <4390000>;
