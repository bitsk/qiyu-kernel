+		reset-gpios = <&tlmm 5 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&imx471_5_default>;
+		status = "okay";
+		port {
+			imx471_5_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <200000000>;
