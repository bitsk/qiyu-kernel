+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/iqiyi,a081-controller.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: iQIYI A081 Nordic controller radio bridge
+
+maintainers:
+  - Qiyu Project <qiyu@example.invalid>
+
+description: |
+  Nordic radio assembly used for the Qiyu MIX controller link. It exchanges
+  36-byte full-duplex SPI frames after a rising data-ready interrupt. The
+  assembly has a power enable and an active-low reset. It is separate from
+  the headset Bluetooth HCI controller.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: iqiyi,a081-controller
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 8000000
+
+  interrupts:
+    maxItems: 1
+    description: Data-ready interrupt, rising edge
+
+  enable-gpios:
+    maxItems: 1
+    description: Radio assembly power enable
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low radio reset
+
+required:
+  - compatible
+  - reg
+  - spi-max-frequency
+  - interrupts
+  - enable-gpios
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        radio@0 {
+            compatible = "iqiyi,a081-controller";
+            reg = <0>;
+            spi-max-frequency = <8000000>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <145 IRQ_TYPE_EDGE_RISING>;
+            enable-gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
+            reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;
+        };
+    };
